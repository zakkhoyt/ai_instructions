// VSCode / GitHub Copilot — Workspace-scope MCP configuration (env var variant)
// Location: .vscode/mcp.json (in repo root)
//
// This variant references environment variables — safe to commit to git.
// Set variables in ~/.zshrc or load .env before launching VSCode from terminal.
//
// See configs/env_vars/.env.example for required variables.

{
  "servers": {

    // XcodeBuildMCP — no auth required
    "XcodeBuildMCP": {
      "command": "npx",
      "args": ["-y", "xcodebuildmcp@latest"],
      "env": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "project-discovery,swift-package,simulator,device,macos,doctor,ui-testing",
        "INCREMENTAL_BUILDS_ENABLED": "false"
      }
    },

    // Apple Docs MCP — no auth required
    "apple-docs": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@kimsungwhee/apple-docs-mcp"]
    },

    // Atlassian (official) — Basic Auth from env var
    // export ATLASSIAN_MCP_CLASSIC_BASIC_AUTH="$(echo -n email:token | base64)"
    "atlassian-rovo-mcp": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "Basic ${ATLASSIAN_MCP_CLASSIC_BASIC_AUTH}"
      }
    },

    // Bugsee — token from env var
    // export BUGSEE_MCP_TOKEN="your-uuid-token"
    "bugsee": {
      "type": "http",
      "url": "https://api.bugsee.com/mcp/${BUGSEE_MCP_TOKEN}"
    }

  },
  "inputs": []
}
