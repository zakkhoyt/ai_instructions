// Claude Desktop — User-scope MCP configuration
// Location: ~/Library/Application Support/Claude/claude_desktop_config.json
//
// Docs: https://modelcontextprotocol.io/docs/quickstart/user
//
// NOTE: Claude Desktop uses "mcpServers" as the top-level key.
// Auth tokens are NOT included here. See:
//   configs/env_vars/claude_desktop_config.json  — uses env var references
//   configs/tokens/claude_desktop_config.json    — has real tokens (gitignore!)
//
// After editing, restart Claude Desktop for changes to take effect.

{
  "mcpServers": {

    // ─────────────────────────────────────────────────────────────────
    // XcodeBuildMCP — Xcode/iOS build, test, simulator automation
    // GitHub: https://github.com/getsentry/XcodeBuildMCP
    // Auth:   None required
    // ─────────────────────────────────────────────────────────────────
    "XcodeBuildMCP": {
      "command": "npx",
      "args": ["-y", "xcodebuildmcp@latest", "mcp"],
      "env": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "project-discovery,swift-package,simulator,device,macos,doctor,ui-testing",
        "INCREMENTAL_BUILDS_ENABLED": "false"
      }
    },

    // ─────────────────────────────────────────────────────────────────
    // Apple Docs MCP — Apple developer documentation + WWDC sessions
    // GitHub: https://github.com/kimsungwhee/apple-docs-mcp
    // Auth:   None required
    // ─────────────────────────────────────────────────────────────────
    "apple-docs": {
      "command": "npx",
      "args": ["-y", "@kimsungwhee/apple-docs-mcp"]
    },

    // ─────────────────────────────────────────────────────────────────
    // Atlassian MCP (official Rovo MCP) — Jira + Confluence
    // Auth:  API token via Basic Auth (lasts 1 year)
    //        Create: https://id.atlassian.com/manage-profile/security/api-tokens
    //        Encode: echo -n "email:token" | base64
    // ─────────────────────────────────────────────────────────────────
    "atlassian-rovo-mcp": {
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "Basic <BASE64_EMAIL_COLON_API_TOKEN>"
      }
    },

    // ─────────────────────────────────────────────────────────────────
    // mcp-atlassian (3rd-party) — Jira + Confluence via wrapper script
    // GitHub: https://github.com/sooperset/mcp-atlassian
    // Auth:   API token injected via wrapper script
    // NOTE:   Docker must be running.
    // ─────────────────────────────────────────────────────────────────
    // "mcp-atlassian": {
    //   "command": "<PATH_TO_WRAPPER_SCRIPT>/mcp_atlassian_wrapper.zsh",
    //   "args": []
    // },

    // ─────────────────────────────────────────────────────────────────
    // Bugsee MCP — crash reports and bug tracking
    // Auth:  Token embedded in URL (long-lived)
    //        Create: https://app.bugsee.com/#/settings/user/integrations
    //
    // SECURITY: Replace placeholder — do not commit real token.
    // ─────────────────────────────────────────────────────────────────
    "bugsee": {
      "url": "https://api.bugsee.com/mcp/<YOUR_BUGSEE_MCP_TOKEN>"
    },

    // ─────────────────────────────────────────────────────────────────
    // GitHub MCP — repos, PRs, issues, code search
    // Auth:  GitHub Personal Access Token (PAT)
    //        Create: https://github.com/settings/tokens
    //        Scopes: repo, read:org, read:user
    // ─────────────────────────────────────────────────────────────────
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_GITHUB_PAT>"
      }
    },

    // ─────────────────────────────────────────────────────────────────
    // App Store Connect MCP — App Store, TestFlight, IAP, reviews, subs
    // GitHub: https://github.com/cristianoaredes/mcp-apple-store
    // Auth:   App Store Connect API Key (.p8 file) — does not expire
    //         Keys: https://appstoreconnect.apple.com/access/api
    //
    // SETUP: Clone repo and build first:
    //   git clone https://github.com/cristianoaredes/mcp-apple-store.git ~/code/other/mcp/mcp-apple-store
    //   cd ~/code/other/mcp/mcp-apple-store && npm install && npm run build
    // ─────────────────────────────────────────────────────────────────
    "apple-store": {
      "command": "node",
      "args": ["/Users/<YOUR_USERNAME>/code/other/mcp/mcp-apple-store/dist/index.js"],
      "env": {
        "APP_STORE_ISSUER_ID": "<YOUR_ASC_ISSUER_ID>",
        "APP_STORE_KEY_ID": "<YOUR_ASC_KEY_ID>",
        "APP_STORE_PRIVATE_KEY_PATH": "<PATH_TO_AUTHKEY.P8>",
        "APP_BUNDLE_ID": "<YOUR_BUNDLE_ID>",
        "APP_APPLE_ID": "<YOUR_APP_APPLE_ID>",
        "APP_STORE_ENVIRONMENT": "Sandbox"
      }
    },

    // ─────────────────────────────────────────────────────────────────
    // Slack MCP (korotovsky) — search Slack, read threads
    // GitHub: https://github.com/korotovsky/slack-mcp-server
    // Auth:   XOXP token (long-lived)
    //         Setup: https://github.com/korotovsky/slack-mcp-server/blob/master/docs/01-authentication-setup.md
    // ─────────────────────────────────────────────────────────────────
    "slack": {
      "command": "npx",
      "args": ["-y", "slack-mcp-server@latest", "--transport", "stdio"],
      "env": {
        "SLACK_MCP_XOXP_TOKEN": "<YOUR_SLACK_XOXP_TOKEN>"
      }
    }

  }
}
