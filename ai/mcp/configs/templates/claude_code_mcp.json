// Claude Code — Project-scope MCP configuration
// Location: .mcp.json (in repository root)
// Committed to git: YES (but do NOT include real tokens)
//
// Docs: https://docs.anthropic.com/en/docs/claude-code/mcp
//
// NOTE: Claude Code uses "mcpServers" as the top-level key.
// For real tokens, see configs/tokens/ (gitignore those files).
//
// Add via CLI:
//   claude mcp add --scope project <name> -- <command> [args...]
//   claude mcp add --scope project --transport http <name> --url <url>

{
  "mcpServers": {

    // ─────────────────────────────────────────────────────────────────
    // XcodeBuildMCP — Xcode/iOS build, test, simulator automation
    // CLI: claude mcp add --scope project --transport stdio XcodeBuildMCP -- xcodebuildmcp mcp
    // GitHub: https://github.com/getsentry/XcodeBuildMCP
    // Auth:   None required
    // ─────────────────────────────────────────────────────────────────
    "XcodeBuildMCP": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "xcodebuildmcp@latest", "mcp"],
      "env": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "project-discovery,swift-package,simulator,device,macos,doctor,ui-testing",
        "INCREMENTAL_BUILDS_ENABLED": "false"
      }
    },

    // ─────────────────────────────────────────────────────────────────
    // Apple Docs MCP
    // CLI: claude mcp add --scope project --transport stdio apple-docs -- npx -y @kimsungwhee/apple-docs-mcp
    // Auth:   None required
    // ─────────────────────────────────────────────────────────────────
    "apple-docs": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@kimsungwhee/apple-docs-mcp"]
    },

    // ─────────────────────────────────────────────────────────────────
    // App Store Connect MCP — App Store, TestFlight, IAP, reviews, subs
    // GitHub: https://github.com/cristianoaredes/mcp-apple-store
    // Auth:   App Store Connect API Key (.p8 file) — does not expire
    // ─────────────────────────────────────────────────────────────────
    "apple-store": {
      "type": "stdio",
      "command": "/bin/zsh",
      "args": ["-lc", "node \"$HOME/code/other/mcp/mcp-apple-store/dist/index.js\""],
      "env": {
        "APP_STORE_ISSUER_ID": "<YOUR_ASC_ISSUER_ID>",
        "APP_STORE_KEY_ID": "<YOUR_ASC_KEY_ID>",
        "APP_STORE_PRIVATE_KEY_PATH": "<PATH_TO_AUTHKEY.P8>",
        "APP_BUNDLE_ID": "<YOUR_BUNDLE_ID>",
        "APP_APPLE_ID": "<YOUR_APP_APPLE_ID>",
        "APP_STORE_ENVIRONMENT": "Sandbox"
      }
    },

    // ─────────────────────────────────────────────────────────────────
    // Atlassian MCP (official Rovo MCP) — Jira + Confluence
    // Auth:  API token via Basic Auth (lasts 1 year)
    //        Create: https://id.atlassian.com/manage-profile/security/api-tokens
    //        Encode: echo -n "email:token" | base64
    //
    // SECURITY: Replace placeholder — do not commit real token.
    // ─────────────────────────────────────────────────────────────────
    "atlassian-rovo-mcp": {
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "Basic <BASE64_EMAIL_COLON_API_TOKEN>"
      }
    },

    // ─────────────────────────────────────────────────────────────────
    // Bugsee MCP — crash reports
    // Auth:  Token in URL (long-lived)
    //        Create: https://app.bugsee.com/#/settings/user/integrations
    //
    // SECURITY: Replace placeholder — do not commit real token.
    // ─────────────────────────────────────────────────────────────────
    "bugsee": {
      "url": "https://api.bugsee.com/mcp/<YOUR_BUGSEE_MCP_TOKEN>"
    }

  }
}
