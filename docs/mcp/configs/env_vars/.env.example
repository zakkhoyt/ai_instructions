# MCP Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.
#
# Usage:
#   1. Copy: cp configs/env_vars/.env.example configs/tokens/.env
#   2. Fill in your tokens below
#   3. Source in ~/.zshrc: source /path/to/.env
#      or load per-session: source configs/tokens/.env
#
# These variables are referenced in configs/env_vars/*.json files.


# ─────────────────────────────────────────────────────────────────────────────
# App Store Connect MCP (mcp-apple-store)
# Create API Key: https://appstoreconnect.apple.com/access/api
# Download the .p8 private key file — cannot be re-downloaded after creation
# ─────────────────────────────────────────────────────────────────────────────

# Issuer ID — shown at top of App Store Connect → Users and Access → Integrations
APPLE_ASC_MCP_ISSUER_ID="<YOUR_ISSUER_ID>"

# Key ID — shown in the key row (matches the filename: AuthKey_<KEYID>.p8)
APPLE_ASC_MCP_KEY_ID="<YOUR_KEY_ID>"

# Absolute path to the downloaded .p8 private key file
APPLE_ASC_MCP_AUTH_KEY_PATH="$HOME/.zsh_home/tokens/AuthKey_<YOUR_KEY_ID>.p8"

# Your app's bundle ID
APPLE_ASC_MCP_BUNDLE_ID="<YOUR_BUNDLE_ID>"

# Your app's numeric Apple ID (found in App Store Connect → App Information)
APPLE_ASC_MCP_APPLE_ID="<YOUR_APPLE_ID>"

# Environment: "Sandbox" or "Production"
APPLE_ASC_MCP_STORE_ENVIRONMENT="Sandbox"

# Log level: "info" | "debug" | "error"
APPLE_ASC_MCP_LOG_LEVEL="info"


# ─────────────────────────────────────────────────────────────────────────────
# Atlassian (Official Rovo MCP + mcp-atlassian 3rd-party)
# Create API token: https://id.atlassian.com/manage-profile/security/api-tokens
# ─────────────────────────────────────────────────────────────────────────────

# Your Atlassian account email
ATLASSIAN_USER_EMAIL="you@hatch.co"

# Your Atlassian API token (from above URL)
ATLASSIAN_AUTH_TOKEN="ATATT3xFf..."

# Base64-encoded "email:token" for Basic Auth header
# Generate: echo -n "${ATLASSIAN_USER_EMAIL}:${ATLASSIAN_AUTH_TOKEN}" | base64
ATLASSIAN_MCP_CLASSIC_BASIC_AUTH=""

# mcp-atlassian 3rd-party (Docker/uvx) env vars
JIRA_URL="https://<your-org>.atlassian.net"
JIRA_USERNAME="<YOUR_EMAIL>"
JIRA_API_TOKEN="ATATT3xFf..."

# Optional: Confluence (if using mcp-atlassian with Confluence)
CONFLUENCE_URL="https://<your-org>.atlassian.net/wiki"
CONFLUENCE_USERNAME="<YOUR_EMAIL>"
CONFLUENCE_API_TOKEN="ATATT3xFf..."


# ─────────────────────────────────────────────────────────────────────────────
# Bugsee MCP
# Create token: https://app.bugsee.com/#/settings/user/integrations
# ─────────────────────────────────────────────────────────────────────────────

# Your Bugsee MCP token (UUID format)
BUGSEE_MCP_TOKEN="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"


# ─────────────────────────────────────────────────────────────────────────────
# GitHub MCP
# Create PAT: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
# ─────────────────────────────────────────────────────────────────────────────

GITHUB_PERSONAL_ACCESS_TOKEN="ghp_..."


# ─────────────────────────────────────────────────────────────────────────────
# Slack MCP (korotovsky)
# Auth setup: https://github.com/korotovsky/slack-mcp-server/blob/master/docs/01-authentication-setup.md
# Token URL: https://app.slack.com/app-settings/T03TR3R94/A0AMLQF741Y/oauth
# ─────────────────────────────────────────────────────────────────────────────

# XOXP (user OAuth token) — starts with "xoxp-"
SLACK_MCP_XOXP_TOKEN="xoxp-..."
# Alias used in some configs:
HATCH_SLACK_MPC_OAUTH_TOKEN="xoxp-..."


# ─────────────────────────────────────────────────────────────────────────────
# Figma MCP
# Create token: https://www.figma.com/developers/api#access-tokens
# ─────────────────────────────────────────────────────────────────────────────

FIGMA_PERSONAL_ACCESS_TOKEN="figd_..."
