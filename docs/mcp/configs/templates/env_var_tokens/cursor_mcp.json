// Cursor — MCP configuration (env var variant)
// User (global) location: ~/.cursor/mcp.json
// Project location:       .cursor/mcp.json (in project root)
//
// Cursor env var variant. Uses `${env:VAR}` interpolation to pull values from
// the shell environment. Launch Cursor from zsh terminal to inherit env vars.
//
// See configs/env_vars/.env.example for required variables.
// See configs/env_vars/zsh/mcp.env for the shell export file to source in ~/.zshrc.

{
  "mcpServers": {

    // # About
    // XcodeBuildMCP - MCP server providing 61+ tools for Xcode and Swift development automation (build, test, simulator control, device interaction, UI automation, project scaffolding)
    //
    // # References
    // * [GitHub: getsentry/XcodeBuildMCP](https://github.com/getsentry/XcodeBuildMCP)
    // * [npm: xcodebuildmcp](https://www.npmjs.com/package/xcodebuildmcp)
    // * [GitHub: getsentry/XcodeBuildMCP - Configuration / Environment Variables](https://github.com/getsentry/XcodeBuildMCP#configuration)
    //
    // # Installation
    // Installed automatically via `npx` on first run. Requires Xcode and Apple Developer Tools.
    //
    // # Authorization
    // None required.
    "XcodeBuildMCP": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec npx -y xcodebuildmcp@latest mcp"
      ],
      "env": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "project-discovery,swift-package,simulator,device,macos,doctor,ui-testing",
        "INCREMENTAL_BUILDS_ENABLED": "false"
        // Optional:
        // "NODE_ENV": "development",
        // "DEBUG": "*",
        // "XCODEBUILDMCP_DYNAMIC_TOOLS": "false",  // set "true" for dynamic tool loading
        // For SPM-only projects use instead:
        // "XCODEBUILDMCP_ENABLED_WORKFLOWS": "swift-package,simulator,project-discovery,doctor",
      }
    },

    // # About
    // apple-docs - Access Apple developer documentation, frameworks, APIs, and 1,260+ WWDC sessions (2012–2025) offline via MCP. Covers iOS, macOS, watchOS, tvOS, visionOS.
    //
    // # References
    // * [GitHub: kimsungwhee/apple-docs-mcp](https://github.com/kimsungwhee/apple-docs-mcp)
    // * [npm: @kimsungwhee/apple-docs-mcp](https://www.npmjs.com/package/@kimsungwhee/apple-docs-mcp)
    // * [GitHub: kimsungwhee/apple-docs-mcp - Environment Variables](https://github.com/kimsungwhee/apple-docs-mcp#environment-variables)
    //
    // # Installation
    // Installed automatically via `npx` on first run. No additional setup required.
    //
    // # Authorization
    // None required.
    "apple-docs": {
      "command": "/bin/zsh",
      "args": ["-lc", "exec npx -y @kimsungwhee/apple-docs-mcp"]
    },

    // # About
    // apple-store - App Store Connect MCP server with 83+ tools for managing IAP, TestFlight, reviews, provisioning profiles, certificates, and app submissions.
    //
    // # References
    // * [GitHub: cristianoaredes/mcp-apple-store](https://github.com/cristianoaredes/mcp-apple-store)
    // * [App Store Connect: API Keys](https://appstoreconnect.apple.com/access/integrations/api)
    // * [GitHub: cristianoaredes/mcp-apple-store - Environment Variables](https://github.com/cristianoaredes/mcp-apple-store#environment-variables)
    //
    // # Installation
    // Must be cloned and built locally. No npm package available.
    //
    // ```zsh
    // git clone https://github.com/cristianoaredes/mcp-apple-store ~/.hatch/config/mpc/apple-store/code/mcp-apple-store
    // cd ~/.hatch/config/mpc/apple-store/code/mcp-apple-store
    // npm install && npm run build
    // ```
    //
    // # Authorization
    // 1) Create an App Store Connect API Key
    //   * [App Store Connect: Users and Access → Integrations → API Keys](https://appstoreconnect.apple.com/access/integrations/api)
    //   * Create a key with the appropriate role (e.g. App Manager or Developer)
    //   * Download the `.p8` file — it can only be downloaded once
    // 2) Note the Issuer ID and Key ID shown on the API Keys page
    // 3) Set the env vars pointing to your `.p8` file and app identifiers
    "apple-store": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "node \"$HOME/.hatch/config/mpc/apple-store/code/mcp-apple-store/dist/index.js\""
      ],
      "env": {
        "APP_STORE_ISSUER_ID": "${env:APPLE_ASC_MCP_ISSUER_ID}",
        "APP_STORE_KEY_ID": "${env:APPLE_ASC_MCP_KEY_ID}",
        "APP_STORE_PRIVATE_KEY_PATH": "${env:APPLE_ASC_MCP_AUTH_KEY_PATH}",
        "APP_BUNDLE_ID": "${env:APPLE_ASC_MCP_BUNDLE_ID}",
        "APP_APPLE_ID": "${env:APPLE_ASC_MCP_APPLE_ID}",
        "APP_STORE_ENVIRONMENT": "${env:APPLE_ASC_MCP_STORE_ENVIRONMENT}",
        "LOG_LEVEL": "${env:APPLE_ASC_MCP_LOG_LEVEL}"
        // Optional:
        // "APPLE_ROOT_CERT_PATH": "./keys/AppleRootCA-G3.cer",
        // "WEBHOOK_PORT": "3000",
        // "WEBHOOK_PATH": "/webhooks/apple"
      }
    },

    // # About
    // atlassian-rovo-mcp - Official Atlassian MCP server for Jira and Confluence via the Rovo MCP Server. Supports creating/editing issues, searching, commenting, and more.
    //
    // # References
    // * [Atlassian: Rovo MCP Server - Getting Started](https://support.atlassian.com/atlassian-rovo-mcp-server/docs/getting-started-with-the-atlassian-remote-mcp-server/)
    // * [Atlassian: Rovo MCP Server - Configuring Authentication via API Token](https://support.atlassian.com/atlassian-rovo-mcp-server/docs/configuring-authentication-via-api-token/)
    // * [Atlassian: Manage API Tokens](https://id.atlassian.com/manage-profile/security/api-tokens)
    //
    // # Installation
    // None required. Remote HTTP server hosted by Atlassian. Accessed via mcp-remote wrapper (stdio → HTTP proxy).
    //
    // # Authorization
    // 1) Create a (Scoped) Atlassian User API Token for the `Rovo MCP Server` app
    //   * [Atlassian: Create API Token (pre-configured for Rovo MCP)](https://id.atlassian.com/manage-profile/security/api-tokens?autofillToken=&expiryDays=max&appId=mcp&selectedScopes=all)
    //   * On the token creation page: select app `Rovo MCP Server`, set expiry to max (1 year)
    //   * **Note: tokens scoped to the `Jira` app will NOT work — must use `Rovo MCP Server`**
    // 2) Create a Basic Authorization hash
    //   * Combine `user.email:api_token` and base64-encode:
    //   * `echo -n "${ATLASSIAN_USER_EMAIL}:${ATLASSIAN_AUTH_TOKEN}" | base64 | pbcopy`
    // 3) Set as `ATLASSIAN_MCP_CLASSIC_BASIC_AUTH` env var (exported in zsh/mcp.env)
    "atlassian-rovo-mcp": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec npx -y mcp-remote https://mcp.atlassian.com/v1/mcp --header \"Authorization: Basic ${env:ATLASSIAN_MCP_CLASSIC_BASIC_AUTH}\""
      ]
    },

    // # About
    // mcp-atlassian - 3rd-party Atlassian MCP server by sooperset. 72 tools covering Jira and Confluence. Runs via uvx (no Docker required). Uses a scoped Atlassian API token.
    //
    // # References
    // * [GitHub: sooperset/mcp-atlassian](https://github.com/sooperset/mcp-atlassian)
    // * [Atlassian: Manage API Tokens](https://id.atlassian.com/manage-profile/security/api-tokens)
    // * [GitHub: sooperset/mcp-atlassian - Configuration / Environment Variables](https://github.com/sooperset/mcp-atlassian#configuration)
    //
    // # Installation
    //
    // ```zsh
    // brew install uv
    // ```
    //
    // # Authorization
    // 1) Create an Atlassian API Token (standard, not scoped)
    //   * [Atlassian: Manage API Tokens](https://id.atlassian.com/manage-profile/security/api-tokens)
    //   * Create token with any name, note the value
    // 2) Create an env file at `~/.hatch/config/vscode/mcp-atlassian.env`
    //   * Contents: `JIRA_URL`, `JIRA_USERNAME` (email), `JIRA_API_TOKEN`
    "mcp-atlassian": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec uvx mcp-atlassian --env-file \"${HOME}/.hatch/config/vscode/mcp-atlassian.env\" --transport stdio"
      ]
    },

    // # About
    // bugsee - Crash reporting and bug tracking MCP server for Bugsee. Auth token is embedded in the MCP URL (token-in-URL pattern). No headers required.
    //
    // # References
    // * [Bugsee: MCP Server Documentation](https://docs.bugsee.com/mcp-server-api/overview)
    // * [Bugsee: User Integrations / Auth Tokens](https://app.bugsee.com/#/settings/user/integrations)
    //
    // # Installation
    // None required. Remote HTTP server hosted by Bugsee. Accessed via mcp-remote wrapper (stdio → HTTP proxy).
    //
    // # Authorization
    // 1) Generate a Bugsee MCP Auth Token
    //   * [Bugsee: User Integrations](https://app.bugsee.com/#/settings/user/integrations)
    //   * Click `Generate Token` and copy the UUID
    // 2) Set as `BUGSEE_MCP_TOKEN` env var
    "bugsee": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec npx -y mcp-remote \"https://api.bugsee.com/mcp/${env:BUGSEE_MCP_TOKEN}\""
      ]
    },

    // # About
    // github - Official GitHub MCP server for repositories, PRs, issues, code search, and GitHub Actions. Runs locally via npx for non-VSCode clients.
    //
    // # References
    // * [GitHub: github/github-mcp-server](https://github.com/github/github-mcp-server)
    // * [GitHub: MCP Server - Authentication](https://github.com/github/github-mcp-server#authentication)
    // * [GitHub: Create a Personal Access Token](https://github.com/settings/tokens)
    // * [GitHub: MCP Server - Configuration / Environment Variables](https://github.com/github/github-mcp-server#configuration)
    //
    // # Installation
    // Installed automatically via `npx` on first run.
    //
    // # Authorization
    // 1) Create a GitHub Personal Access Token (PAT)
    //   * [GitHub: Create a PAT](https://github.com/settings/tokens)
    //   * Required scopes: `repo`, `read:org`, `read:user`
    // 2) Set as `GITHUB_PERSONAL_ACCESS_TOKEN` env var
    "github": {
      "command": "/bin/zsh",
      "args": ["-lc", "exec npx -y @modelcontextprotocol/server-github"],
      "env": {
        // Env var is set in ~/.zshrc or .env file
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },

    // # About
    // slack - MCP server for reading and searching Slack channels, threads, and user profiles. Uses an XOXP user OAuth token for authentication.
    //
    // # References
    // * [GitHub: korotovsky/slack-mcp-server](https://github.com/korotovsky/slack-mcp-server)
    // * [korotovsky/slack-mcp-server: Authentication Setup](https://github.com/korotovsky/slack-mcp-server/blob/master/docs/01-authentication-setup.md)
    // * [Slack App Settings - OAuth & Permissions](https://app.slack.com/app-settings/)
    // * [GitHub: korotovsky/slack-mcp-server - Environment Variables](https://github.com/korotovsky/slack-mcp-server#environment-variables)
    //
    // # Installation
    // Installed automatically via `npx` on first run.
    //
    // # Authorization
    // 1) Obtain a Slack XOXP User OAuth Token
    //   * LastPass: `Shared-iOS-devs` → `MCP` → `SLACK_MCP_XOXP_TOKEN` (shared team token)
    //   * Or: visit your Slack app's OAuth & Permissions page and copy the `xoxp-...` token
    // 2) Set as `HATCH_SLACK_MPC_OAUTH_TOKEN` env var
    "slack": {
      "command": "/bin/zsh",
      "args": ["-lc", "exec npx -y slack-mcp-server@latest --transport stdio"],
      "env": {
        // Env var is set in ~/.zshrc or .env file
        "SLACK_MCP_XOXP_TOKEN": "${env:HATCH_SLACK_MPC_OAUTH_TOKEN}"
      }
    },

    // # About
    // google-workspace - Google Workspace MCP server. Access Docs, Drive, Gmail, Calendar, Sheets, Forms, Tasks, and Contacts.
    //
    // # References
    // * [GitHub: taylorwilsdon/google_workspace_mcp](https://github.com/taylorwilsdon/google_workspace_mcp)
    // * [Google Cloud Console: OAuth Credentials](https://console.cloud.google.com/apis/credentials)
    //
    // # Installation
    // Installed automatically via `uvx` on first run. Requires `uv`:
    //
    // ```zsh
    // brew install uv
    // ```
    //
    // # Authorization
    // 1) Obtain the shared Google OAuth client JSON
    //   * LastPass: `Shared-iOS-devs` → `MCP` → `GOOGLE_WORKSPACE` (shared team token)
    //   * Copy JSON to a local path, e.g. ~/.zsh_home/tokens/mcp/google/google_mcp_client.json
    //   * Do NOT commit this file
    // 2) Set GOOGLE_CLIENT_SECRET_PATH to the local JSON file path
    // 3) Set USER_GOOGLE_EMAIL to your @hatch.co Google email
    // 4) On first use a browser OAuth prompt appears — sign in once; tokens cache locally
    "google-workspace": {
      "type": "stdio",
      "command": "uvx",
      "args": ["workspace-mcp", "--single-user"],
      "env": {
        "GOOGLE_CLIENT_SECRET_PATH": "${env:GOOGLE_MCP_CLIENT_SECRET_PATH}",
        "USER_GOOGLE_EMAIL": "${env:GOOGLE_MCP_USER_EMAIL}"
      }
    },

    // ─────────────────────────────────────────────────────────────────────────
    // SourceKit-LSP — NOT an MCP server; configured separately in .claude/.lsp.json
    //
    // # About
    // sourcekit-lsp - Apple's official LSP server for Swift. Provides code
    // completion, go-to-definition, hover documentation, cross-module references,
    // and diagnostics across the full Hatch iOS codebase. Ships bundled with
    // Xcode; no installation required.
    //
    // # References
    // * [GitHub: swiftlang/sourcekit-lsp](https://github.com/swiftlang/sourcekit-lsp)
    // * [Claude Code: LSP docs](https://docs.anthropic.com/en/docs/claude-code/lsp)
    // * [Docs: ios-sourcekit-lsp.md](docs/mcp/servers/ios-sourcekit-lsp.md)
    //
    // # Config location
    // .claude/.lsp.json at the repo root (see docs/mcp/configs/templates/claude_code_lsp.json)
    // This entry is NOT placed in this MCP config file — LSP and MCP use separate
    // protocols and separate config files.
    //
    "sourcekit-lsp": {
      "command": "sourcekit-lsp",
      "args": ["--scratch-path", ".build/sourcekit-lsp"],
      "extensionToLanguage": { ".swift": "swift" },
      "workspaceFolder": "iOS/hatch-sleep-app",
      "startupTimeout": 15000,
      "restartOnCrash": true,
      "maxRestarts": 3
    }
    // ─────────────────────────────────────────────────────────────────────────

  }
}
