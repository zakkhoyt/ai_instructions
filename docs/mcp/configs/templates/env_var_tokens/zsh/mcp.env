# MCP Server Environment Variables — Shell Export File
# Source this file in ~/.zshrc:
#   source /path/to/ai/mcp/configs/env_vars/zsh/mcp.env
#
# Variables exported here become available to any AI platform launched from
# the same zsh session. See platform-specific notes below.
#
# IMPORTANT — Claude Desktop: As a macOS .app bundle, Claude Desktop does NOT
# inherit shell env when launched from Dock/Spotlight. For Claude Desktop, use
# the env_vars/ configs which embed tokens in "env": {} blocks instead.
# Claude Desktop must be launched from terminal: open -a "Claude" to inherit.
#
# See configs/env_vars/.env.example for descriptions and token URLs.

# ─────────────────────────────────────────────────────────────────────────────
# App Store Connect MCP (mcp-apple-store)
# Create API Key: https://appstoreconnect.apple.com/access/api
# ─────────────────────────────────────────────────────────────────────────────
export APPLE_ASC_MCP_ISSUER_ID="<YOUR_ISSUER_ID>"
export APPLE_ASC_MCP_KEY_ID="<YOUR_KEY_ID>"
export APPLE_ASC_MCP_AUTH_KEY_PATH="$HOME/.zsh_home/tokens/AuthKey_<YOUR_KEY_ID>.p8"
export APPLE_ASC_MCP_BUNDLE_ID="<YOUR_BUNDLE_ID>"
export APPLE_ASC_MCP_APPLE_ID="<YOUR_APPLE_ID>"
export APPLE_ASC_MCP_STORE_ENVIRONMENT="Sandbox"
export APPLE_ASC_MCP_LOG_LEVEL="info"

# ─────────────────────────────────────────────────────────────────────────────
# Atlassian (Official Rovo MCP + mcp-atlassian 3rd-party)
# Create API token: https://id.atlassian.com/manage-profile/security/api-tokens
# ─────────────────────────────────────────────────────────────────────────────
export ATLASSIAN_USER_EMAIL="<YOUR_EMAIL>"
export ATLASSIAN_AUTH_TOKEN="ATATT3xFf..."
# Base64-encoded "email:token" for Basic Auth header
# Generate: echo -n "${ATLASSIAN_USER_EMAIL}:${ATLASSIAN_AUTH_TOKEN}" | base64
export ATLASSIAN_MCP_CLASSIC_BASIC_AUTH=""
export JIRA_URL="https://<your-org>.atlassian.net"
export JIRA_USERNAME="<YOUR_EMAIL>"
export JIRA_API_TOKEN="ATATT3xFf..."
export CONFLUENCE_URL="https://<your-org>.atlassian.net/wiki"
export CONFLUENCE_USERNAME="<YOUR_EMAIL>"
export CONFLUENCE_API_TOKEN="ATATT3xFf..."

# ─────────────────────────────────────────────────────────────────────────────
# Bugsee MCP
# Create token: https://app.bugsee.com/#/settings/user/integrations
# ─────────────────────────────────────────────────────────────────────────────
export BUGSEE_MCP_TOKEN="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────────────────────
# GitHub MCP
# Create PAT: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
# ─────────────────────────────────────────────────────────────────────────────
export GITHUB_PERSONAL_ACCESS_TOKEN="ghp_..."

# ─────────────────────────────────────────────────────────────────────────────
# Slack MCP (korotovsky)
# Auth setup: https://github.com/korotovsky/slack-mcp-server/blob/master/docs/01-authentication-setup.md
# ─────────────────────────────────────────────────────────────────────────────
export SLACK_MCP_XOXP_TOKEN="xoxp-..."
export HATCH_SLACK_MPC_OAUTH_TOKEN="xoxp-..."

# ─────────────────────────────────────────────────────────────────────────────
# Figma MCP
# Create token: https://www.figma.com/developers/api#access-tokens
# ─────────────────────────────────────────────────────────────────────────────
export FIGMA_PERSONAL_ACCESS_TOKEN="figd_..."
